        {
          "Name": "ControleTresBotoes",
          "Width": 192,
          "Instance": {
            "Members": "bool FAguardandoInicio = true;\r\nbool FExecutando = false;\r\nbool FResetArmado = false;\r\nbool FPararArmado = true;\r\nunsigned long FUltimoParar = 0;\r\nunsigned long FUltimoIniciar = 0;\r\nunsigned long FUltimoReset = 0;",
            "Inputs": {
              "*": [
                {
                  "Name": "PararContinuar",
                  "InputPin": {
                    "SourcePin": {
                      "ID": "__OpenWireRootUnit__.InverterBotaoParar.OutputPin"
                    }
                  },
                  "+": "TArduinoCustomCodeInputDigitalElement",
                  "OnData": "if( !AValue )\r\n{\r\n  FPararArmado = true;\r\n}\r\nelse if( FPararArmado )\r\n{\r\n  FPararArmado = false;\r\n  if( !FAguardandoInicio )\r\n  {\r\n    unsigned long AAgora = millis();\r\n    if(( AAgora - FUltimoParar >= 80 ) || ( FUltimoParar == 0 ))\r\n    {\r\n      FUltimoParar = AAgora;\r\n      FExecutando = !FExecutando;\r\n      Executando.Send( FExecutando );\r\n    }\r\n  }\r\n}"
                },
                {
                  "Name": "Iniciar",
                  "InputPin": {
                    "SourcePin": {
                      "ID": "__OpenWireRootUnit__.InverterBotaoIniciar.OutputPin"
                    }
                  },
                  "+": "TArduinoCustomCodeInputDigitalElement",
                  "OnData": "if( AValue )\r\n{\r\n  unsigned long AAgora = millis();\r\n  if(( AAgora - FUltimoIniciar >= 80 ) || ( FUltimoIniciar == 0 ))\r\n  {\r\n    FUltimoIniciar = AAgora;\r\n    FAguardandoInicio = false;\r\n    FExecutando = true;\r\n    Executando.Send( true );\r\n  }\r\n}"
                },
                {
                  "Name": "Reset",
                  "InputPin": {
                    "SourcePin": {
                      "ID": "__OpenWireRootUnit__.InverterBotaoReset.OutputPin"
                    }
                  },
                  "+": "TArduinoCustomCodeInputDigitalElement",
                  "OnData": "if( !AValue )\r\n{\r\n  FResetArmado = true;\r\n}\r\nelse if( FResetArmado )\r\n{\r\n  unsigned long AAgora = millis();\r\n  if(( AAgora - FUltimoReset >= 80 ) || ( FUltimoReset == 0 ))\r\n  {\r\n    FResetArmado = false;\r\n    FUltimoReset = AAgora;\r\n    FExecutando = false;\r\n    FAguardandoInicio = true;\r\n    Executando.Send( false );\r\n    delay( 20 );\r\n    asm volatile ( \"jmp 0\" );\r\n  }\r\n}"
                }
              ]
            },
            "Outputs": {
              "*": [
                {
                  "Name": "Executando",
                  "OutputPin": {
                    "SinkPins": [
                      {
                        "Name": "__OpenWireRootUnit__.PulseGenerator1.Enabled",
                        "ID": "__OpenWireRootUnit__.PulseGenerator1.EnabledInputPin"
                      },
                      {
                        "Name": "__OpenWireRootUnit__.PulseGenerator2.Enabled",
                        "ID": "__OpenWireRootUnit__.PulseGenerator2.EnabledInputPin"
                      },
                      {
                        "Name": "__OpenWireRootUnit__.PulseGenerator3.Enabled",
                        "ID": "__OpenWireRootUnit__.PulseGenerator3.EnabledInputPin"
                      },
                      {
                        "Name": "__OpenWireRootUnit__.RandomUnsignedGenerator1.Enabled",
                        "ID": "__OpenWireRootUnit__.RandomUnsignedGenerator1.EnabledInputPin"
                      }
                    ]
                  },
                  "+": "TArduinoCustomCodeOutputDigitalElement"
                }
              ]
            },
            "+": "TArduinoCustomCode",
            "OnStart": "FAguardandoInicio = true;\r\nFExecutando = false;\r\nExecutando.Send( false );"
          },
          "X": 288,
          "Height": 128,
          "Y": 1168,
          "Type": "Component"
        }
      ],
